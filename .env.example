# Database Configuration
DATABASE_NAME=ralph_ng
DATABASE_USER=ralph_ng
DATABASE_PASSWORD=ralph_ng
DATABASE_HOST=db
DATABASE_PORT=3306

# Redis Configuration
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0

# Ralph Settings
RALPH_DEBUG=1
SECRET_KEY=change-me-in-production-to-a-random-string
ALLOWED_HOSTS=*

# Superuser Credentials (created during initialization)
RALPH_SUPERUSER_USERNAME=admin
RALPH_SUPERUSER_PASSWORD=admin
RALPH_SUPERUSER_EMAIL=admin@example.com

# Load demo data on initialization (true/false)
LOAD_DEMO_DATA=false

